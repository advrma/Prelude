{
  "name": "prelude",
  "version": "0.1.0",
  "private": true,
  "description": "Your AI goes on the first date for you, reveals the match step by step, then books the real one.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/seed.ts --reset",
    "night": "tsx scripts/run-night.ts",
    "night:mock": "tsx scripts/run-night.ts --mock",
    "check": "tsx scripts/check-models.ts",
    "avatars": "tsx scripts/gen-avatars.ts",
    "shots": "tsx scripts/screenshots.ts",
    "e2e": "tsx scripts/demo-e2e.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@next/env": "^15.5.28",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
